{
  "name": "consultorio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestión de consultorio médico",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @consultorio/api db:migrate",
    "db:studio": "pnpm --filter @consultorio/api db:studio",
    "setup": "pnpm --filter @consultorio/api setup"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
