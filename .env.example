# Copia este archivo a .env y completa los valores.
# NUNCA subas .env al repositorio.

# --- Base de datos ---
DATABASE_URL="postgresql://usuario:clave@localhost:5432/consultorio?schema=public"

# --- Entorno ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Autenticación ---
# Genera secretos distintos y largos con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- URLs ---
# Orígenes permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Correo (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Consultorio <no-responder@ejemplo.com>"

# --- Integraciones (opcionales, se activan en hitos posteriores) ---
# Consulta de DNI: apis.net.pe, json.pe, decolecta, factiliza...
DNI_API_URL=
DNI_API_TOKEN=

# WhatsApp Business Cloud API (H6)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Redis para la cola de trabajos (H6)
REDIS_URL=
